# Optional environment secrets for the send-confirmation-emails Edge Function.
#
# RESEND_API_KEY and WEBHOOK_SECRET normally live in Supabase Vault (resend_api_key and
# email_webhook_secret, see the README). Set them here only to override Vault. Values set in the
# environment win. For a local copy, use supabase/.env.local (gitignored) and run:
#   npx supabase secrets set --env-file supabase/.env.local
# Names starting with SUPABASE_ are provided automatically and must not be set.

# Resend API key (resend.com, API Keys). Secret. Never commit it.
RESEND_API_KEY=re_your_key_here

# Shared secret the database sends in the x-webhook-secret header. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into Supabase Vault as email_webhook_secret (see README).
WEBHOOK_SECRET=generate-a-long-random-value

EMAIL_FROM=NEXUS-E <noreply@nexuse.org>
# Optional. Leave empty for no reply-to address.
EMAIL_REPLY_TO=
SITE_URL=https://register.nexuse.org

# Optional tuning. Defaults shown.
# EMAIL_DAILY_CAP=100
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_BATCH_SIZE=20
