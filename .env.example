# Supabase project (Project Settings > API). The anon key is safe to expose in the browser
# because Row Level Security protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site (used for links and metadata)
VITE_SITE_URL=https://register.example.org

# Cloudflare Turnstile site key (optional, leave empty to disable until you add it)
VITE_TURNSTILE_SITE_KEY=

# Public contact address shown in the site footer (optional, leave empty to show a general line instead)
VITE_CONTACT_EMAIL=
